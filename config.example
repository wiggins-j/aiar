# AIAR configuration — copy to a shell profile or `source` before running.
# Everything is environment-driven; nothing is required (sane defaults apply).

# ---- Model (model-agnostic — point at ANY Qwen you have pulled) -------------
# Pick a tag sized to your hardware. Verify it's pullable at
# https://ollama.com/library/qwen ; model specs at https://huggingface.co/Qwen
# (always check these for the latest models — tags age).
export OLLAMA_MODEL="qwen2.5:7b"            # e.g. qwen2.5:3b (laptops), qwen3:14b (stronger), ...
export OLLAMA_URL="http://localhost:11434/api/generate"
export MODEL_LIST_PREFIXES="qwen"          # Settings model dropdown filter (comma-sep; "" = show all)

# ---- RAG store -------------------------------------------------------------
export AIAR_DB_PATH="$HOME/.aiar/knowledge"  # ChromaDB persistent dir
export AIAR_CORPUS="aiar"                     # the "default" instance's collection name
export RAG_INSTANCE="default"                 # active RAG instance (multi-instance; "none" = No RAG)
export AIAR_EMBEDDING_MODEL="all-MiniLM-L6-v2"
export RAG_TOP_K=3                            # chunks injected into the prompt

# ---- Retrieval-quality flags (all default OFF; turn on for relevance) ------
export RAG_HYBRID_ENABLED=0                   # vector + BM25 RRF fusion
export RAG_RERANK_ENABLED=0                   # cross-encoder reranking
export RAG_FETCH_K=20                         # wide first pass when reranking
export RAG_QUERY_REWRITE_MODE=off             # off | rewrite | hyde
export RAG_RERANK_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"

# ---- Grounding (reground) --------------------------------------------------
export GROUNDING_BASE_DIR="$HOME/.aiar"       # where corrections are stored
export GROUNDING_REINJECTION_ENABLED=0        # auto-apply corrections to every answer
                                              # (the GUI "Reground" toggle forces it per-call)

# ---- Observability + GUI ---------------------------------------------------
export AIAR_LOG_DIR="$HOME/.aiar/logs/llm"    # JSONL call log (the GUI tails this)
export AIAR_BASE_DIR="$HOME/.aiar"            # eval-queue.jsonl + verdicts.jsonl
export AIAR_WEB_HOST="127.0.0.1"
export AIAR_WEB_PORT=8088
export AIAR_REASON_THRESHOLD=7                # score <= this requires a correction
